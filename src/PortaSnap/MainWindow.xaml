<Window x:Class="PortaSnap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortaSnap" Width="380" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/PortaSnap.ico">
    <StackPanel Margin="18,16,18,16">
        <!-- Header -->
        <DockPanel Margin="0,0,0,14">
            <Image Source="pack://application:,,,/Assets/PortaSnap.ico" Width="28" Height="28" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="PortaSnap" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="SubtitleText" Text="Portable screen capture" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"/>
            </StackPanel>
        </DockPanel>

        <!-- Mode switch -->
        <Border Background="#E5E7EB" CornerRadius="8" Padding="3">
            <UniformGrid Columns="2">
                <RadioButton x:Name="ImageMode" Style="{StaticResource SegmentRadio}" GroupName="Mode" IsChecked="True" Checked="Mode_Changed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" Margin="0,0,6,0"/>
                        <TextBlock Text="Image" FontWeight="SemiBold"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="VideoMode" Style="{StaticResource SegmentRadio}" GroupName="Mode" Checked="Mode_Changed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE714;" Margin="0,0,6,0"/>
                        <TextBlock Text="Video" FontWeight="SemiBold"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
        </Border>

        <!-- Image options -->
        <Border x:Name="ImageOptions" Background="White" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Selection" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="SelectionCombo" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="Region or window (drag or click)"/>
                    <ComboBoxItem Content="Full screen (monitor under the cursor)"/>
                    <ComboBoxItem Content="Scrolling window"/>
                </ComboBox>
                <TextBlock Text="Delay" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="DelayCombo" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="No delay" Tag="0"/>
                    <ComboBoxItem Content="3 seconds" Tag="3"/>
                    <ComboBoxItem Content="5 seconds" Tag="5"/>
                    <ComboBoxItem Content="10 seconds" Tag="10"/>
                </ComboBox>
                <UniformGrid Columns="2" Margin="0,12,0,2">
                    <CheckBox x:Name="CursorCheck" Content="Capture cursor" Margin="0,3" Click="Option_Changed"/>
                    <CheckBox x:Name="MagnifierCheck" Content="Magnifier" Margin="0,3" Click="Option_Changed"/>
                    <CheckBox x:Name="ClipboardCheck" Content="Copy to clipboard" Margin="0,3" Click="Option_Changed"/>
                    <CheckBox x:Name="EditorCheck" Content="Open in editor" Margin="0,3" Click="Option_Changed"/>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Video options -->
        <Border x:Name="VideoOptions" Background="White" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Frame rate" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FpsCombo" SelectionChanged="Option_Changed">
                    <ComboBoxItem Content="15 fps (small files)" Tag="15"/>
                    <ComboBoxItem Content="24 fps" Tag="24"/>
                    <ComboBoxItem Content="30 fps (recommended)" Tag="30"/>
                    <ComboBoxItem Content="60 fps (smooth, larger)" Tag="60"/>
                </ComboBox>
                <UniformGrid Columns="2" Margin="0,12,0,2">
                    <CheckBox x:Name="MicCheck" Content="Record microphone" Margin="0,3" Click="Option_Changed"/>
                    <CheckBox x:Name="VideoCursorCheck" Content="Show cursor" Margin="0,3" Click="Option_Changed"/>
                    <CheckBox x:Name="CountdownCheck" Content="3-second countdown" Margin="0,3" Click="Option_Changed"/>
                </UniformGrid>
                <TextBlock Text="Saved as MP4 (H.264/AAC) using the encoder built into Windows." TextWrapping="Wrap"
                           Foreground="{StaticResource SubtleTextBrush}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Capture button -->
        <Button x:Name="CaptureButton" Margin="0,14,0,0" Height="48" Click="Capture_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                    <Setter Property="FontSize" Value="15"/>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="CaptureButtonText" Text="Capture" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <TextBlock x:Name="HotkeyHint" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextAlignment="Center"/>

        <!-- Footer -->
        <UniformGrid Columns="3" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Margin="0,0,4,0" Click="Editor_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="Editor"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Margin="2,0" Click="Library_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B9;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="Library"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="13" Margin="0,0,6,0"/>
                    <TextBlock Text="Settings"/>
                </StackPanel>
            </Button>
        </UniformGrid>
    </StackPanel>
</Window>
