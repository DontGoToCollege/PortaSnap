<Window x:Class="PortaSnap.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PortaSnap.Editor"
        Title="PortaSnap Editor" Width="1320" Height="840" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True" AllowDrop="True"
        Icon="pack://application:,,,/Assets/PortaSnap.ico">
    <DockPanel>
        <!-- Command bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource PrimaryButton}" Click="Capture_Click" ToolTip="New capture (Print Screen)" Margin="0,0,8,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Capture"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Open_Click" ToolTip="Open an image, .psnap or .snagx file (Ctrl+O)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" Margin="0,0,5,0"/><TextBlock Text="Open"/></StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource FlatButton}" Click="Save_Click" ToolTip="Save to the library (Ctrl+S)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" Margin="0,0,5,0"/><TextBlock Text="Save"/></StackPanel>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource FlatButton}" Click="Export_Click" ToolTip="Save as PNG, JPG, BMP, GIF, TIFF or a .psnap project (Ctrl+E)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE792;" Margin="0,0,5,0"/><TextBlock Text="Export"/></StackPanel>
                    </Button>
                    <Button x:Name="CopyButton" Style="{StaticResource FlatButton}" Click="Copy_Click" ToolTip="Copy the finished image (Ctrl+Shift+C)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,5,0"/><TextBlock Text="Copy"/></StackPanel>
                    </Button>
                    <Border x:Name="DragHandle" Background="Transparent" CornerRadius="6" Padding="8,5" Cursor="SizeAll"
                            ToolTip="Drag from here and drop into another app (chat, email, documents…)"
                            PreviewMouseLeftButtonDown="DragHandle_MouseDown" PreviewMouseMove="DragHandle_MouseMove">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;" Margin="0,0,5,0"/><TextBlock Text="Drag out" VerticalAlignment="Center"/></StackPanel>
                    </Border>
                    <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="8,3"/>
                    <Button x:Name="UndoButton" Style="{StaticResource FlatButton}" Click="Undo_Click" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource FlatButton}" Click="Redo_Click" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A6;"/>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="8,3"/>
                    <Button x:Name="ResizeButton" Style="{StaticResource FlatButton}" Click="Resize_Click" ToolTip="Resize the image">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" Margin="0,0,5,0"/><TextBlock Text="Resize"/></StackPanel>
                    </Button>
                    <Button x:Name="CanvasButton" Style="{StaticResource FlatButton}" Click="Canvas_Click" ToolTip="Add space around the image">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9A6;" Margin="0,0,5,0"/><TextBlock Text="Canvas"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ZoomCombo" Width="86" VerticalAlignment="Center" SelectionChanged="ZoomCombo_SelectionChanged">
                        <ComboBoxItem Content="Fit" Tag="0"/>
                        <ComboBoxItem Content="25%" Tag="0.25"/>
                        <ComboBoxItem Content="50%" Tag="0.5"/>
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="100%" Tag="1"/>
                        <ComboBoxItem Content="150%" Tag="1.5"/>
                        <ComboBoxItem Content="200%" Tag="2"/>
                        <ComboBoxItem Content="300%" Tag="3"/>
                        <ComboBoxItem Content="400%" Tag="4"/>
                    </ComboBox>
                    <Rectangle Width="1" Fill="{DynamicResource LineBrush}" Margin="8,3"/>
                    <Button Style="{StaticResource FlatButton}" Click="Library_Click" ToolTip="Open the library">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B9;" Margin="0,0,5,0"/><TextBlock Text="Library"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Settings_Click" ToolTip="Settings">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Tool strip -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel x:Name="ToolStrip" Orientation="Horizontal"/>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock x:Name="ZoomStatus" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}"/>
                <TextBlock x:Name="PointerStatus" DockPanel.Dock="Right" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,18,0"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Recent captures tray -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Height="100">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Width="70" VerticalAlignment="Center">
                    <TextBlock Text="Recent" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource FlatButton}" Click="Library_Click" Margin="0,4,0,0" ToolTip="Open the full library">
                        <TextBlock Text="All…" Foreground="{DynamicResource AccentBrush}"/>
                    </Button>
                </StackPanel>
                <ListBox x:Name="RecentList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseLeftButtonUp="RecentList_MouseUp">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="116" Height="76" Margin="1" ToolTip="{Binding Title}">
                                <Border Background="{DynamicResource InsetBrush}" CornerRadius="4">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3"/>
                                </Border>
                                <Border Visibility="{Binding VideoBadge}" Background="#CC111827" CornerRadius="3" HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom" Margin="5" Padding="4,1">
                                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" Foreground="White" FontSize="10"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Properties panel (built in code) -->
        <Border DockPanel.Dock="Right" Width="276" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PropsPanel" Margin="14,8,14,16"/>
            </ScrollViewer>
        </Border>

        <!-- Canvas -->
        <Grid>
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource CanvasBackBrush}" Focusable="False" PreviewMouseWheel="Scroller_PreviewMouseWheel" SizeChanged="Scroller_SizeChanged">
                <Grid x:Name="ZoomHost" Margin="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1"/>
                    </Grid.LayoutTransform>
                    <local:EditorCanvas x:Name="EditCanvas" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Canvas x:Name="TextLayer" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                </Grid>
            </ScrollViewer>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="No capture open" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource EmptyTextBrush}"/>
                <TextBlock Text="Press Print Screen, click Capture, open a file, or drop an image here." Foreground="{DynamicResource SubtleTextBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
