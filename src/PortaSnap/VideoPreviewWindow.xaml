<Window x:Class="PortaSnap.VideoPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortaSnap Video" Width="1000" Height="680" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/PortaSnap.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,8">
            <DockPanel>
                <Button x:Name="PlayButton" Style="{StaticResource FlatButton}" Click="Play_Click" Width="40" Height="32" ToolTip="Play / pause (Space)">
                    <TextBlock x:Name="PlayGlyph" Style="{StaticResource Glyph}" Text="&#xE768;"/>
                </Button>
                <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="8,0" MinWidth="104" Foreground="{DynamicResource SubtleTextBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Click="SaveFrame_Click" ToolTip="Open the current frame in the editor as a new image">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="13" Margin="0,0,5,0"/><TextBlock Text="Grab frame"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="CopyFile_Click" ToolTip="Copy the video file (paste into chats, email, folders)">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="13" Margin="0,0,5,0"/><TextBlock Text="Copy"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="SaveAs_Click" ToolTip="Save a copy somewhere else">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="13" Margin="0,0,5,0"/><TextBlock Text="Save as…"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="Reveal_Click" ToolTip="Show in folder">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;"/>
                    </Button>
                </StackPanel>
                <Slider x:Name="Seek" VerticalAlignment="Center" Margin="8,0,12,0" IsMoveToPointEnabled="True" ValueChanged="Seek_ValueChanged"/>
            </DockPanel>
        </Border>
        <Grid Background="#111827">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                          MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
            <TextBlock x:Name="ErrorText" Foreground="White" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</Window>
