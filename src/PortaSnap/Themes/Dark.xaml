<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette (same keys as Light.xaml). -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3A66"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#F16A6E"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#1C1D20"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#26272B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#36373C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECECEE"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9FA1A8"/>
    <SolidColorBrush x:Key="EmptyTextBrush" Color="#B4B6BC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#323338"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3C3D43"/>
    <SolidColorBrush x:Key="InputBrush" Color="#2E2F34"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#46474E"/>
    <SolidColorBrush x:Key="SegmentBackBrush" Color="#2E2F34"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#45464D"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#1F2023"/>
    <SolidColorBrush x:Key="CanvasBackBrush" Color="#151618"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#55575E"/>
    <SolidColorBrush x:Key="ToolTipBrush" Color="#2E2F34"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#26272B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#ECECEE"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#26272B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#ECECEE"/>
</ResourceDictionary>
