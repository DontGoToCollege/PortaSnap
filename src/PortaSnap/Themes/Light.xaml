<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Dark.xaml defines the same keys; ThemeManager swaps one for the other at runtime. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E53935"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="EmptyTextBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E2E5EA"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="SegmentBackBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InsetBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="CanvasBackBrush" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CE"/>
    <SolidColorBrush x:Key="ToolTipBrush" Color="#FFFFFF"/>

    <!-- System colours used by any stock WPF template we don't restyle (e.g. the ScrollViewer corner). -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#111827"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#111827"/>
</ResourceDictionary>
